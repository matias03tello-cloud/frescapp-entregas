# Configuración pública del cliente Expo; estos valores pueden incluirse en la app.
# Nunca poner contraseñas, claves privadas, tokens ni credenciales del servidor aquí.
EXPO_PUBLIC_PRIVACY_RESPONSABLE=
EXPO_PUBLIC_PRIVACY_EMAIL=

# Hito 3: API propia del proyecto y configuración de emuladores locales.
# Para una demo local, activa los emuladores y configura su proyecto en .env.local.
# Producción requiere confirmar el despliegue y configurar la URL de la API.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
EXPO_PUBLIC_FIREBASE_PROJECT_ID=super-ahorro-app
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# Web opcional: registrar la clave y los dominios en reCAPTCHA Enterprise/App Check.
EXPO_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Dejar false para pruebas. true bloquea el arranque hasta implementar atestación nativa.
EXPO_PUBLIC_REQUIRE_NATIVE_APP_CHECK=false

# Backend Hito 2: valores locales de ejemplo; no son credenciales ni claves privadas.
# Firebase Functions lee su configuración local desde functions/.env.
# Copia functions/.env.example a functions/.env; no copies claves privadas.
ENFORCE_APP_CHECK=false

# Valores locales para ejecutar db/crear-estructura-hito2.cjs contra Firestore Emulator.
# Configúralos en la terminal al ejecutar el script; nunca apuntan a producción.
GCLOUD_PROJECT=demo-frescapp-hito2
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
